# Checkpoints: ignore all except last 4 important experiments
checkpoints/*
!checkpoints/.gitkeep
!checkpoints/2025-10-12_16-34-13_convnext_tiny_batch64/
!checkpoints/2025-10-13_06-31-55_resnet50_batch64/
!checkpoints/2025-10-13_13-24-25_vit_base_patch16_224_batch64/
!checkpoints/2025-10-14_01-36-55_custom_vit_batch64/
